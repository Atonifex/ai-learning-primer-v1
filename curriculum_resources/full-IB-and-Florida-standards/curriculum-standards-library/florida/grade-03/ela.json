  "sections": {
    "grade_and_subject": {
      "official_subject_name": "English Language Arts",
      "standards_system_name": "B.E.S.T. Standards (Benchmarks for Excellent Student Thinking)",
      "organization": "by_grade",
      "courses": null
    },
    "domains": [
      {
        "domain_id": "ELA.3.R.1",
        "domain_name": "Reading Prose and Poetry",
        "standards": [
          {
            "id": "ELA.3.R.1.1",
            "text": "Explain how one or more characters develop throughout the plot in a literary text.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15207"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.R.1.2",
            "text": "Explain a theme and how it develops, using details, in a literary text.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15208"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.R.1.3",
            "text": "Explain different characters' perspectives in a literary text.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15209"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.R.1.4",
            "text": "Identify types of poems: free verse, rhymed verse, haiku, and limerick.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15210"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.3.R.2",
        "domain_name": "Reading Informational Text",
        "standards": [
          {
            "id": "ELA.3.R.2.1",
            "text": "Explain how text features contribute to meaning and identify the text structures of chronology, comparison, and cause/effect in texts.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15211"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.R.2.2",
            "text": "Identify the central idea and explain how relevant details support that idea in a text.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15212"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.R.2.3",
            "text": "Explain what evidence the author uses to support an idea or claim in a text.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15213"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.R.2.4",
            "text": "Identify an author's claim and explain how an author uses evidence to support the claim.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15214"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.3.R.3",
        "domain_name": "Reading Across Genres",
        "standards": [
          {
            "id": "ELA.3.R.3.1",
            "text": "Identify and explain metaphors, personification, and hyperbole in text(s).",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15215"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.R.3.2",
            "text": "Summarize a text to enhance comprehension. Include plot and theme for a literary text. Use the central idea and relevant details for an informational text.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15216"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.R.3.3",
            "text": "Compare and contrast how two authors present information on the same topic or theme.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15217"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.3.C.1",
        "domain_name": "Communicating Through Writing",
        "standards": [
          {
            "id": "ELA.3.C.1.1",
            "text": "Write in cursive all upper- and lowercase letters.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15220"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.C.1.2",
            "text": "Write personal or fictional narratives using a logical sequence of events, appropriate descriptions, dialogue, a variety of transitional words or phrases, and an ending.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15218"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.C.1.3",
            "text": "Write opinions about a topic or text, include reasons supported by details from one or more sources, use transitions, and provide a conclusion.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15219"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.C.1.4",
            "text": "Write expository texts about a topic, using one or more sources, providing an introduction, facts and details, some elaboration, transitions, and a conclusion.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15221"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.C.1.5",
            "text": "Improve writing as needed by planning, revising, and editing with guidance and support from adults and feedback from peers.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15222"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.3.C.2",
        "domain_name": "Communicating Orally",
        "standards": [
          {
            "id": "ELA.3.C.2.1",
            "text": "Present information orally, in a logical sequence, using nonverbal cues, appropriate volume, and clear pronunciation.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15223"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.3.C.3",
        "domain_name": "Following Conventions",
        "standards": [
          {
            "id": "ELA.3.C.3.1",
            "text": "Follow the rules of standard English grammar, punctuation, capitalization, and spelling appropriate to grade level.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15224"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.3.C.4",
        "domain_name": "Researching",
        "standards": [
          {
            "id": "ELA.3.C.4.1",
            "text": "Conduct research to answer a question, organizing information about the topic from multiple sources.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15225"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.3.C.5",
        "domain_name": "Creating and Collaborating",
        "standards": [
          {
            "id": "ELA.3.C.5.1",
            "text": "Use two or more multimedia elements to enhance oral or written tasks.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15226"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.C.5.2",
            "text": "Use digital writing tools individually or collaboratively to plan, draft, and revise writing.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15227"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.3.V.1",
        "domain_name": "Finding Meaning",
        "standards": [
          {
            "id": "ELA.3.V.1.1",
            "text": "Use grade-level academic vocabulary appropriately in speaking and writing.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15228"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.V.1.2",
            "text": "Identify and apply knowledge of common Greek and Latin roots, base words, and affixes to determine the meaning of unfamiliar words in grade-level content.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15229"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.V.1.3",
            "text": "Use context clues, figurative language, word relationships, reference materials, and/or background knowledge to determine the meaning of multiple-meaning and unknown words and phrases, appropriate to grade level.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15230"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.3.F.1",
        "domain_name": "Learning and Applying Foundational Reading Skills",
        "standards": [
          {
            "id": "ELA.3.F.1.3",
            "text": "Use knowledge of grade-level phonics and word-analysis skills to decode words. Decode words with common Greek and Latin roots and affixes (See ELA.3.V.1.2). Decode words with common derivational suffixes and describe how they turn words into different parts of speech (e.g., -ful, -less, -est). Decode multisyllabic words.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15002"],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.3.F.1.4",
            "text": "Read grade-level texts with accuracy, automaticity, and appropriate prosody or expression.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15003"],
            "page": null,
            "label": "A"
          }
        ]
      }
    ],
    "assessment_notes": null,
    "key_learning_outcomes": {
      "label": "C",
      "items": [
        "Students explain character development, theme, and perspective in literary texts.",
        "Students identify and explain figurative language (metaphors, personification, hyperbole).",
        "Students analyze informational text structure, central ideas, and author's evidence.",
        "Students write narratives, opinions, and expository texts with appropriate structure.",
        "Students apply grade-level conventions, vocabulary, and foundational reading skills."
      ]
    },
    "version_and_update_notes": {
