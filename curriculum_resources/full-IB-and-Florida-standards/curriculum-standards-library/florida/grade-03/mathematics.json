    "domains": [
      {
        "domain_id": "MA.3.NSO.1",
        "domain_name": "Number Sense and Operations - Place Value and Number Forms",
        "standards": [
          {
            "id": "MA.3.NSO.1.1",
            "text": "Read and write numbers from 0 to 10,000 using standard form, expanded form and word form.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15307"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.NSO.1.2",
            "text": "Compose and decompose four-digit numbers in multiple ways using thousands, hundreds, tens and ones. Demonstrate each composition or decomposition using objects, drawings and expressions or equations.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15308"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.NSO.1.3",
            "text": "Plot, order and compare whole numbers up to 10,000.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15309"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.NSO.1.4",
            "text": "Round whole numbers from 0 to 1,000 to the nearest 10 or 100.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15310"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.NSO.2",
        "domain_name": "Number Sense and Operations - Addition, Subtraction, Multiplication, and Division",
        "standards": [
          {
            "id": "MA.3.NSO.2.1",
            "text": "Add and subtract multi-digit whole numbers including using a standard algorithm with procedural fluency.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15311"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.NSO.2.2",
            "text": "Explore multiplication of two whole numbers with products from 0 to 144, and related division facts.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15312"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.NSO.2.3",
            "text": "Multiply a one-digit whole number by a multiple of 10, up to 90, or a multiple of 100, up to 900, with procedural reliability.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15313"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.NSO.2.4",
            "text": "Multiply two whole numbers from 0 to 12 and divide using related facts with procedural reliability.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15314"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.FR.1",
        "domain_name": "Fractions - Fractions as Numbers",
        "standards": [
          {
            "id": "MA.3.FR.1.1",
            "text": "Represent and interpret unit fractions in the form 1/n as the quantity formed by one part when a whole is partitioned into n equal parts.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15315"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.FR.1.2",
            "text": "Represent and interpret fractions, including fractions greater than one, in the form m/n as the result of adding the unit fraction 1/n to itself m times.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15316"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.FR.1.3",
            "text": "Read and write fractions, including fractions greater than one, using standard form, numeral-word form and word form.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15317"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.FR.2",
        "domain_name": "Fractions - Operations with Fractions",
        "standards": [
          {
            "id": "MA.3.FR.2.1",
            "text": "Plot, order and compare fractional numbers with the same numerator or the same denominator.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15318"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.FR.2.2",
            "text": "Identify equivalent fractions and explain why they are equivalent.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15319"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.AR.1",
        "domain_name": "Algebraic Reasoning - Multiplication and Division",
        "standards": [
          {
            "id": "MA.3.AR.1.1",
            "text": "Apply the distributive property to multiply a one-digit number and two-digit number. Apply properties of multiplication to find a product of one-digit whole numbers.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15320"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.AR.1.2",
            "text": "Solve one- and two-step real-world problems involving any of four operations with whole numbers.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15321"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.AR.2",
        "domain_name": "Algebraic Reasoning - Equality",
        "standards": [
          {
            "id": "MA.3.AR.2.1",
            "text": "Restate a division problem as a missing factor problem using the relationship between multiplication and division.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15322"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.AR.2.2",
            "text": "Determine and explain whether an equation involving multiplication or division is true or false.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15323"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.AR.2.3",
            "text": "Determine the unknown whole number in a multiplication or division equation, relating three whole numbers, with the unknown in any position.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15324"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.AR.3",
        "domain_name": "Algebraic Reasoning - Patterns",
        "standards": [
          {
            "id": "MA.3.AR.3.1",
            "text": "Determine and explain whether a whole number from 1 to 1,000 is even or odd.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15325"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.AR.3.2",
            "text": "Determine whether a whole number from 1 to 144 is a multiple of a given one-digit number.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15326"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.AR.3.3",
            "text": "Identify, create and extend numerical patterns.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15327"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.M.1",
        "domain_name": "Measurement - Measure Length, Time, and Money",
        "standards": [
          {
            "id": "MA.3.M.1.1",
            "text": "Select and use appropriate tools to measure the length of an object, the volume of liquid within a beaker and temperature.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15328"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.M.1.2",
            "text": "Solve real-world problems involving any of the four operations with whole-number lengths, masses, weights, temperatures or liquid volumes.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15329"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.M.2",
        "domain_name": "Measurement - Time and Money",
        "standards": [
          {
            "id": "MA.3.M.2.1",
            "text": "Using analog and digital clocks tell and write time to the nearest minute using a.m. and p.m. appropriately. Express portions of an hour using the fractional terms half an hour, half past, quarter of an hour, quarter after and quarter til.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15330"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.M.2.2",
            "text": "Solve one- and two-step real-world problems involving elapsed time.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15331"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.M.2.3",
            "text": "Count and represent money amounts, compute sales tax, calculate change, and solve real-world problems involving money.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15332"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.GR.1",
        "domain_name": "Geometric Reasoning - Two-Dimensional Figures",
        "standards": [
          {
            "id": "MA.3.GR.1.1",
            "text": "Describe and draw points, lines, line segments, rays, intersecting lines, perpendicular lines and parallel lines. Identify these in two-dimensional figures.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15333"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.GR.1.2",
            "text": "Identify and draw quadrilaterals based on their defining attributes. Quadrilaterals include parallelograms, rhombi, rectangles, squares and trapezoids.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15334"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.GR.1.3",
            "text": "Draw line(s) of symmetry in a two-dimensional figure and identify line-symmetric two-dimensional figures.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15335"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.GR.2",
        "domain_name": "Geometric Reasoning - Area and Perimeter",
        "standards": [
          {
            "id": "MA.3.GR.2.1",
            "text": "Explore area as an attribute of a two-dimensional figure by covering the figure with unit squares without gaps or overlaps. Find areas of rectangles by counting unit squares.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15336"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.GR.2.2",
            "text": "Find the area of a rectangle with whole-number side lengths using a visual model and a multiplication formula.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15337"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.GR.2.3",
            "text": "Solve mathematical and real-world problems involving the area of rectangles that can be decomposed into two smaller rectangles using a visual model and a multiplication formula.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15338"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.GR.2.4",
            "text": "Solve mathematical and real-world problems involving the perimeter of polygons, including finding the perimeter given the side lengths, finding an unknown side length, and finding rectangles with the same perimeter and different areas or the same area and different perimeters.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15339"],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "MA.3.DP.1",
        "domain_name": "Data Analysis and Probability - Collect, Represent and Interpret Data",
        "standards": [
          {
            "id": "MA.3.DP.1.1",
            "text": "Collect and represent numerical and categorical data with whole-number values using tables, scaled pictographs, scaled bar graphs or line plots. Use appropriate titles, labels and units.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15340"],
            "page": null,
            "label": "A"
          },
          {
            "id": "MA.3.DP.1.2",
            "text": "Interpret data with whole-number values represented with tables, scaled pictographs, circle graphs, scaled bar graphs or line plots by solving one- and two-step problems.",
            "text_mode": "exact",
            "citation_ids": ["c-cpalms-15341"],
            "page": null,
            "label": "A"
          }
        ]
      }
    ],
    "assessment_notes": null,
    "key_learning_outcomes": {
      "label": "C",
      "items": [
        "Students read, write, and compare numbers to 10,000 and round to nearest 10 or 100.",
        "Students multiply and divide within 144 with procedural reliability.",
        "Students understand fractions as numbers and compare fractions with same numerator or denominator.",
        "Students solve one- and two-step word problems with all four operations.",
        "Students measure and calculate area and perimeter of rectangles."
      ]
    },
