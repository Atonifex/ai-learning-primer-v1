        "domain_id": "SS.4.CG.3",
        "domain_name": "Civics and Government - Structure of Government",
        "standards": [
          {
            "id": "SS.4.CG.3.1",
            "text": "Explain the structure and functions of the legislative, executive, and judicial branches of government in Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-16066"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.CG.3.2",
            "text": "Compare the structure, functions, and processes of local and state government.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-16067"
            ],
