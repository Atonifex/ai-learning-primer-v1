    "key_learning_outcomes": {
      "label": "C",
      "items": [
        "Students analyze Florida history from Native American tribes through modern day.",
        "Students understand European colonization, territorial period, and statehood.",
        "Students identify Florida's physical and cultural geography features.",
        "Students learn Florida's economic role and contributions of entrepreneurs.",
        "Students understand Florida's constitution and three branches of state government."
      ]
    },
