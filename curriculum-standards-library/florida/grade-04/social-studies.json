    "domains": [
      {
        "domain_id": "SS.4.A.1",
        "domain_name": "American History - Historical Inquiry and Analysis",
        "standards": [
          {
            "id": "SS.4.A.1.1",
            "text": "Analyze primary and secondary resources to identify significant individuals and events throughout Florida history.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-2994"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.1.2",
            "text": "Synthesize information related to Florida history through print and electronic media.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-2995"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.A.2",
        "domain_name": "American History - Native Americans in Florida",
        "standards": [
          {
            "id": "SS.4.A.2.1",
            "text": "Compare Native American tribes in Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-2996"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.A.3",
        "domain_name": "American History - European Contact and Colonial Florida",
        "standards": [
          {
            "id": "SS.4.A.3.1",
            "text": "Identify explorers who came to Florida and the motivations for their expeditions.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-2997"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.3.2",
            "text": "Describe causes and effects of European colonization on the Native American tribes of Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-2998"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.3.3",
            "text": "Identify the significance of St. Augustine as the oldest permanent European settlement in the United States.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-2999"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.3.4",
            "text": "Explain the purpose of and daily life on missions (San Luis de Talimali in present-day Tallahassee).",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3000"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.3.5",
            "text": "Identify the significance of Fort Mose as the first free African community in the United States.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3001"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.3.6",
            "text": "Identify the effects of Spanish rule in Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3002"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.3.7",
            "text": "Identify nations (Spain, France, England) that controlled Florida before it became a United States territory.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3003"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.3.8",
            "text": "Explain how the Seminole tribe formed and the purpose for their migration.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3004"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.3.9",
            "text": "Explain how Florida (Adams-Onis Treaty) became a U.S. territory.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3005"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.3.10",
            "text": "Identify the causes and effects of the Seminole Wars.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3006"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.A.4",
        "domain_name": "American History - Territorial Florida",
        "standards": [
          {
            "id": "SS.4.A.4.1",
            "text": "Explain the effects of technological advances on Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3007"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.4.2",
            "text": "Describe pioneer life in Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3008"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.A.5",
        "domain_name": "American History - Civil War and Reconstruction",
        "standards": [
          {
            "id": "SS.4.A.5.1",
            "text": "Describe Florida's involvement (secession, blockades of ports, the battles of Ft. Pickens, Olustee, Ft. Brooke, Natural Bridge, food supply) in the Civil War.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3009"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.5.2",
            "text": "Summarize challenges Floridians faced during Reconstruction.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3010"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.A.6",
        "domain_name": "American History - Late 19th and Early 20th Century Florida",
        "standards": [
          {
            "id": "SS.4.A.6.1",
            "text": "Describe the economic development of Florida's major industries.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3011"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.6.2",
            "text": "Summarize contributions immigrant groups made to Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3012"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.6.3",
            "text": "Describe the contributions of significant individuals to Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3013"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.6.4",
            "text": "Describe effects of the Spanish American War on Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3014"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.A.7",
        "domain_name": "American History - Florida in the 1920s-1940s",
        "standards": [
          {
            "id": "SS.4.A.7.1",
            "text": "Describe the causes and effects of the 1920's Florida land boom and bust.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3015"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.7.2",
            "text": "Summarize challenges Floridians faced during the Great Depression.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3016"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.A.8",
        "domain_name": "American History - Modern Florida",
        "standards": [
          {
            "id": "SS.4.A.8.1",
            "text": "Identify Florida's role in the Civil Rights Movement.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3017"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.8.2",
            "text": "Describe how and why immigration impacts Florida today.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3018"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.8.3",
            "text": "Describe the effect of the United States' space program on Florida's economy and growth.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3019"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.A.8.4",
            "text": "Explain how tourism affects Florida's economy and growth.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3020"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.A.9",
        "domain_name": "American History - Chronological Thinking",
        "standards": [
          {
            "id": "SS.4.A.9.1",
            "text": "Utilize timelines to sequence key events in Florida history.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3021"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.G.1",
        "domain_name": "Geography - Florida Physical and Cultural Geography",
        "standards": [
          {
            "id": "SS.4.G.1.1",
            "text": "Identify physical features of Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3022"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.G.1.2",
            "text": "Locate and label cultural features on a Florida map.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3023"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.G.1.3",
            "text": "Explain how weather impacts Florida.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3024"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.G.1.4",
            "text": "Interpret political and physical maps using map elements (title, compass rose, cardinal directions, intermediate directions, symbols, legend, scale, longitude, latitude).",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3025"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "SS.4.E.1",
        "domain_name": "Economics - Florida's Economy",
        "standards": [
          {
            "id": "SS.4.E.1.1",
            "text": "Identify entrepreneurs from various social and ethnic backgrounds who have influenced Florida and local economy.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-3026"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "SS.4.E.1.2",
            "text": "Explain Florida's role in the national and international economy and conditions that attract businesses to the state.",
