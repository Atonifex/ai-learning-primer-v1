  "sections": {
    "grade_and_subject": {
      "official_subject_name": "English Language Arts",
      "standards_system_name": "B.E.S.T. Standards (Benchmarks for Excellent Student Thinking)",
      "organization": "by_grade",
      "courses": null
    },
    "domains": [
      {
        "domain_id": "ELA.4.R.1",
        "domain_name": "Reading Prose and Poetry",
        "standards": [
          {
            "id": "ELA.4.R.1.1",
            "text": "Explain how setting, events, conflict, and character development contribute to the plot in a literary text.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14957"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.R.1.2",
            "text": "Explain a stated or implied theme and how it develops, using details, in a literary text.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14958"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.R.1.3",
            "text": "Identify the narrator's point of view and explain the difference between a narrator's point of view and character perspective in a literary text.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14959"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.R.1.4",
            "text": "Explain how rhyme and structure create meaning in a poem.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14960"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.4.R.2",
        "domain_name": "Reading Informational Text",
        "standards": [
          {
            "id": "ELA.4.R.2.1",
            "text": "Explain how text features contribute to the meaning and identify the text structures of problem/solution, sequence, and description in texts.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14961"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.R.2.2",
            "text": "Explain how relevant details support the central idea, implied or explicit.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14962"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.R.2.3",
            "text": "Explain an author's perspective toward a topic in an informational text.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14963"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.R.2.4",
            "text": "Explain an author's claim and the reasons and evidence used to support the claim.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14964"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.4.R.3",
        "domain_name": "Reading Across Genres",
        "standards": [
          {
            "id": "ELA.4.R.3.1",
            "text": "Explain how figurative language contributes to meaning in text(s).",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14965"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.R.3.2",
            "text": "Summarize a text to enhance comprehension. a. Include plot and theme for a literary text. b. Include the central idea and relevant details for an informational text.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14966"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.R.3.3",
            "text": "Compare and contrast accounts of the same event using primary and/or secondary sources.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14967"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.4.C.1",
        "domain_name": "Communicating Through Writing",
        "standards": [
          {
            "id": "ELA.4.C.1.1",
            "text": "Demonstrate legible cursive writing skills.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14968"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.C.1.2",
            "text": "Write personal or fictional narratives using a logical sequence of events and demonstrating an effective use of techniques such as descriptions and transitional words and phrases.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14969"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.C.1.3",
            "text": "Write to make a claim supporting a perspective with logical reasons, using evidence from multiple sources, elaboration, and an organizational structure with transitions.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14970"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.C.1.4",
            "text": "Write expository texts about a topic, using multiple sources, elaboration, and an organizational structure with transitions.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14971"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.C.1.5",
            "text": "Improve writing by planning, revising, and editing, with guidance and support from adults and feedback from peers.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14972"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.4.C.2",
        "domain_name": "Communicating Orally",
        "standards": [
          {
            "id": "ELA.4.C.2.1",
            "text": "Present information orally, in a logical sequence, using nonverbal cues, appropriate volume, and clear pronunciation.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14973"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.4.C.3",
        "domain_name": "Following Conventions",
        "standards": [
          {
            "id": "ELA.4.C.3.1",
            "text": "Follow the rules of standard English grammar, punctuation, capitalization, and spelling appropriate to grade level.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14974"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.4.C.4",
        "domain_name": "Researching",
        "standards": [
          {
            "id": "ELA.4.C.4.1",
            "text": "Conduct research to answer a question, organizing information about the topic and using multiple valid sources.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14975"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.4.C.5",
        "domain_name": "Creating and Collaborating",
        "standards": [
          {
            "id": "ELA.4.C.5.1",
            "text": "Arrange multimedia elements to create emphasis in oral or written tasks.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14976"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.C.5.2",
            "text": "Use digital writing tools individually or collaboratively to plan, draft, and revise writing.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14977"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.4.V.1",
        "domain_name": "Finding Meaning",
        "standards": [
          {
            "id": "ELA.4.V.1.1",
            "text": "Use grade-level academic vocabulary appropriately in speaking and writing.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14978"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.V.1.2",
            "text": "Apply knowledge of common Greek and Latin roots, base words, and affixes to determine the meaning of unfamiliar words in grade-level content.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14979"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.V.1.3",
            "text": "Use context clues, figurative language, word relationships, reference materials, and/or background knowledge to determine the meaning of multiple-meaning and unknown words and phrases, appropriate to grade level.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14980"
            ],
            "page": null,
            "label": "A"
          }
        ]
      },
      {
        "domain_id": "ELA.4.F.1",
        "domain_name": "Learning and Applying Foundational Reading Skills",
        "standards": [
          {
            "id": "ELA.4.F.1.3",
            "text": "Use knowledge of grade-level phonics and word-analysis skills to decode words. Apply knowledge of all letter-sound correspondences, syllabication patterns, and morphology to read and write unfamiliar single-syllable and multisyllabic words in and out of context.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14955"
            ],
            "page": null,
            "label": "A"
          },
          {
            "id": "ELA.4.F.1.4",
            "text": "Read grade-level texts with accuracy, automaticity, and appropriate prosody or expression.",
            "text_mode": "exact",
            "citation_ids": [
              "c-cpalms-14956"
            ],
            "page": null,
            "label": "A"
          }
        ]
      }
    ],
    "assessment_notes": null,
    "key_learning_outcomes": {
      "label": "C",
      "items": [
        "Students explain how literary elements (setting, conflict, character, theme) contribute to plot.",
        "Students identify author's perspective and claims with supporting evidence.",
        "Students write narratives, arguments, and expository texts with multiple sources.",
        "Students apply Greek/Latin roots and context clues to determine word meanings.",
        "Students read grade-level texts with fluency and expression."
      ]
    },
    "version_and_update_notes": {
