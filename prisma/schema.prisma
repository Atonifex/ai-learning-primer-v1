generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  createdAt      DateTime        @default(now())
  learnerProfile LearnerProfile?
}

model LearnerProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id])
  displayName        String?
  gradeBand          String              @default("3")
  primarySubjectSlug String              @default("math_g3")
  activeLanguage     Language?
  currentLevel       Level?
  goals              String
  interests          String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  memoryItems        MemoryItem[]
  skillProgress      SkillProgress[]
  standardsProgress  StandardsProgress[]
  standardsEvidence  StandardsEvidence[]
  storyStates        StoryState[]
  characterPortraits CharacterPortrait[]
  storyWorld         StoryWorld?
  learnerSubjects    LearnerSubject[]
  activityCompletions LearningActivityCompletion[]
  assessmentResults  AssessmentResult[]
  reviewItems        ReviewItem[]
}

enum Language {
  ES
  ZH
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// One woven narrative world per learner (persistent setting + continuity).
model StoryWorld {
  id               String         @id @default(cuid())
  learnerProfileId String         @unique
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  title            String         @default("Your story")
  bible            String         @default("")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  storyArcs        StoryArc[]
}

model Subject {
  id               String              @id @default(cuid())
  slug             String              @unique
  domain           SubjectDomain
  gradeBand        String
  framework        String
  targetLanguage   Language?
  displayName      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         Session[]
  learnerSubjects  LearnerSubject[]
  standardsCatalogs StandardsCatalog[]
  learningActivities LearningActivity[]
  assessments      Assessment[]
}

enum SubjectDomain {
  MATH
  ELA
  SCIENCE
  SOCIAL_STUDIES
  WORLD_LANGUAGE
}

model LearnerSubject {
  id               String               @id @default(cuid())
  learnerProfileId String
  learnerProfile   LearnerProfile       @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  status           LearnerSubjectStatus @default(ACTIVE)
  enrolledAt       DateTime             @default(now())

  @@unique([learnerProfileId, subjectId])
}

enum LearnerSubjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model StandardsCatalog {
  id          String    @id @default(cuid())
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  version     String
  label       String
  framework   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  strands     Strand[]
  standards   Standard[]
  storyArcs   StoryArc[]

  @@unique([subjectId, version])
}

model Strand {
  id            String           @id @default(cuid())
  catalogId     String
  catalog       StandardsCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  code          String
  displayName   String
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  standardGroups StandardGroup[]

  @@unique([catalogId, code])
}

model StandardGroup {
  id              String    @id @default(cuid())
  strandId        String
  strand          Strand    @relation(fields: [strandId], references: [id], onDelete: Cascade)
  code            String
  displayName     String
  purpose         String?
  bigIdeaSummary  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  standards       Standard[]

  @@unique([strandId, code])
}

model Standard {
  id                    String                   @id @default(cuid())
  catalogId             String
  catalog               StandardsCatalog         @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  standardGroupId       String
  standardGroup         StandardGroup            @relation(fields: [standardGroupId], references: [id], onDelete: Cascade)
  code                  String
  description           String
  examples              Json?
  clarifications        Json?
  purposeAndStrategies  String?
  commonMisconceptions  String?
  glossaryTerms         String[]                 @default([])
  verticalAlignment     Json?
  accessPoints          Json?
  contentComplexity     String?
  verificationStatus    String?
  sourceUrl             String?
  primerNotes           Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  standardsProgress     StandardsProgress[]
  standardsEvidence     StandardsEvidence[]
  skillLinks            SkillStandardLink[]
  activityLinks         LearningActivityStandardLink[]
  assessmentLinks       AssessmentStandardLink[]

  @@unique([catalogId, code])
}

model StoryArc {
  id                  String            @id @default(cuid())
  storyWorldId        String
  storyWorld          StoryWorld        @relation(fields: [storyWorldId], references: [id], onDelete: Cascade)
  standardsCatalogId  String
  standardsCatalog    StandardsCatalog  @relation(fields: [standardsCatalogId], references: [id], onDelete: Restrict)
  title               String
  summary             String?
  /// High-level pedagogical / narrative emphasis for the arc (refined per chapter in `Chapter.focusTags`).
  focusTags           String[]          @default([])
  status              StoryArcStatus    @default(ACTIVE)
  orderIndex          Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  chapters            Chapter[]
}

enum StoryArcStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ABANDONED
}

model Chapter {
  id               String         @id @default(cuid())
  storyArcId       String
  storyArc         StoryArc       @relation(fields: [storyArcId], references: [id], onDelete: Cascade)
  title            String
  orderIndex       Int
  /// Refined from `StoryArc.focusTags` when the chapter is created.
  focusTags        String[]       @default([])
  status           ChapterStatus  @default(ACTIVE)
  pathAheadWhisper String?
  handoffSummary   String?
  plannerJson      Json?
  actCurrent       Int            @default(1)
  actTotal         Int            @default(3)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  branchPoints     BranchPoint[]
  incomingBranches BranchOption[] @relation("BranchNextChapter")
}

enum ChapterStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ABANDONED_HANDOFF
}

model Session {
  id               String         @id @default(cuid())
  learnerProfileId String
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id])
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id])
  targetLanguage   Language?
  status           SessionStatus  @default(ACTIVE)
  arcName          String?
  arcSummary       String?
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  /// Wall-clock seconds for this sitting (set on complete/abandon). No daily cap.
  durationSeconds  Int?
  chapterId        String?
  chapter          Chapter?       @relation(fields: [chapterId], references: [id])
  sceneIndex       Int            @default(0)
  messages         Message[]
  storyState       StoryState?
  memoryItems      MemoryItem[]   @relation("SourceSession")
  standardsEvidence StandardsEvidence[]
  activityCompletions LearningActivityCompletion[]
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model Message {
  id               String      @id @default(cuid())
  sessionId        String
  session          Session     @relation(fields: [sessionId], references: [id])
  role             MessageRole
  content          String
  imageUrl         String?
  imagePrompt      String?
  imageStoragePath String?
  orderIndex       Int
  createdAt        DateTime    @default(now())
}

enum MessageRole {
  USER
  ASSISTANT
}

/// At most two logical portraits per character: first establishing shot + latest (middle scenes not retained in Storage).
model CharacterPortrait {
  id                 String         @id @default(cuid())
  learnerProfileId   String
  learnerProfile     LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  characterKey       String
  displayName        String?
  firstMessageId     String?
  latestMessageId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([learnerProfileId, characterKey])
}

model MemoryItem {
  id               String         @id @default(cuid())
  learnerProfileId String
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id])
  type             MemoryType
  content          String
  confidence       Float          @default(1.0)
  sourceSessionId  String?
  sourceSession    Session?       @relation("SourceSession", fields: [sourceSessionId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum MemoryType {
  VOCABULARY_GAP
  RECURRING_MISTAKE
  MISCONCEPTION
  STRENGTH
  CONFIDENCE_SIGNAL
  CONFIDENCE_LEVEL
  INTEREST
  INTEREST_SIGNAL
  GOAL
  PREFERENCE
  STORY_CONTINUITY
  STORY_BEAT
}

/// Spaced-retrieval review schedule. Surfaced as a 2–3 question "expedition log review" when due.
model ReviewItem {
  id             String         @id @default(cuid())
  learnerId      String
  learner        LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  standardCode   String
  conceptSummary String
  nextReviewAt   DateTime
  timesReviewed  Int            @default(0)
  lastScore      Float?
  createdAt      DateTime       @default(now())

  @@index([learnerId, nextReviewAt])
}

model Skill {
  id                  String              @id @default(cuid())
  slug                String              @unique
  displayName         String
  description         String
  subjectScope        String[]            @default([])
  aggregationStrategy AggregationStrategy @default(WEIGHTED_MEAN)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  progress            SkillProgress[]
  standardLinks       SkillStandardLink[]
}

enum AggregationStrategy {
  WEIGHTED_MEAN
  MIN_OF_LINKS
  BAYESIAN
}

model SkillStandardLink {
  id         String   @id @default(cuid())
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  standardId String
  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  weight     Float    @default(1.0)
  notes      String?

  @@unique([skillId, standardId])
}

model SkillProgress {
  id               String         @id @default(cuid())
  learnerProfileId String
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  mastery          Float          @default(0)
  confidence       Float          @default(0.5)
  evidenceCount    Int            @default(0)
  lastObservedAt   DateTime       @default(now())

  @@unique([learnerProfileId, skillId])
}

model StandardsProgress {
  id                 String         @id @default(cuid())
  learnerProfileId   String
  learnerProfile     LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  standardId         String
  standard           Standard       @relation(fields: [standardId], references: [id], onDelete: Cascade)
  mastery            Float          @default(0)
  confidence         Float          @default(0.5)
  evidenceCount      Int            @default(0)
  lastObservedAt     DateTime       @default(now())
  lastDemonstratedAt DateTime?
  nextReviewAt       DateTime?

  @@unique([learnerProfileId, standardId])
}

model StandardsEvidence {
  id               String             @id @default(cuid())
  learnerProfileId String
  learnerProfile   LearnerProfile     @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  standardId       String
  standard         Standard           @relation(fields: [standardId], references: [id], onDelete: Cascade)
  sourceType       EvidenceSourceType
  sourceId         String?
  sessionId        String?
  session          Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  messageId        String?
  evidenceTier     EvidenceTier
  correctness      Float?
  hintsUsed        Int?
  difficulty       Float?
  rubricMatches    String[]           @default([])
  notes            String?
  createdAt        DateTime           @default(now())
}

enum EvidenceSourceType {
  CONVERSATIONAL
  ACTIVITY
  ASSESSMENT
}

enum EvidenceTier {
  CONVERSATIONAL
  GUIDED
  CHECKPOINT
}

model StoryState {
  id                  String         @id @default(cuid())
  learnerProfileId    String
  learnerProfile      LearnerProfile @relation(fields: [learnerProfileId], references: [id])
  sessionId           String         @unique
  session             Session        @relation(fields: [sessionId], references: [id])
  arcName             String
  currentState        String
  recurringCharacters Json
  activeThemes        String[]
  lastUpdatedAt       DateTime       @updatedAt
}

model LearningActivity {
  id               String                         @id @default(cuid())
  slug             String                         @unique
  displayName      String
  kind             ActivityKind
  subjectId        String
  subject          Subject                        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  description      String
  estimatedMinutes Int?
  difficulty       Int?
  content          Json?
  narrativeContext String?
  authoring        ActivityAuthoring              @default(AI_GENERATED)
  generatedFromSessionId String?
  generatedAt      DateTime?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  standardLinks    LearningActivityStandardLink[]
  completions      LearningActivityCompletion[]
}

enum ActivityKind {
  READING
  INTERACTIVE_GAME
  MINI_QUIZ
  CHALLENGE
  STORY_SCENE
  JOURNAL_PROMPT
}

enum ActivityAuthoring {
  AI_GENERATED
  HAND_AUTHORED
  TEMPLATE
}

model LearningActivityStandardLink {
  id               String           @id @default(cuid())
  learningActivityId String
  learningActivity LearningActivity @relation(fields: [learningActivityId], references: [id], onDelete: Cascade)
  standardId       String
  standard         Standard         @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([learningActivityId, standardId])
}

model LearningActivityCompletion {
  id                 String           @id @default(cuid())
  learnerProfileId   String
  learnerProfile     LearnerProfile   @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  learningActivityId String
  learningActivity   LearningActivity @relation(fields: [learningActivityId], references: [id], onDelete: Cascade)
  sessionId          String?
  session            Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  durationSeconds    Int?
  /// Spoken or typed response (chapter reflection / journal).
  responseText       String?
  score              Float?
  perStandardCorrectness Json?
  evidenceWritten    Boolean          @default(false)

  @@index([sessionId])
}

model Assessment {
  id               String                   @id @default(cuid())
  slug             String                   @unique
  displayName      String
  subjectId        String
  subject          Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  format           AssessmentFormat
  items            Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  standardLinks    AssessmentStandardLink[]
  results          AssessmentResult[]
}

enum AssessmentFormat {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  MIXED
}

model AssessmentStandardLink {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  standardId   String
  standard     Standard   @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, standardId])
}

model AssessmentResult {
  id               String         @id @default(cuid())
  learnerProfileId String
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  assessmentId     String
  assessment       Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  total            Float?
  perStandardScores Json?
  itemResults      Json?
  attemptedAt      DateTime       @default(now())
}

model BranchPoint {
  id         String    @id @default(cuid())
  chapterId  String
  chapter    Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  promptText String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  options    BranchOption[]
}

model BranchOption {
  id               String   @id @default(cuid())
  branchPointId    String
  branchPoint      BranchPoint @relation(fields: [branchPointId], references: [id], onDelete: Cascade)
  orderIndex       Int
  title            String
  teaser           String
  imageUrl         String?
  imageStoragePath String?
  imagePrompt      String?
  nextChapterId    String?
  nextChapter      Chapter? @relation("BranchNextChapter", fields: [nextChapterId], references: [id])
}
